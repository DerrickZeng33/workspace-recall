<Window x:Class="WorkspaceRecall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Space Recorder"
        Icon="/Assets/workspace-recall-icon.png"
        Width="1440"
        Height="1024"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0C1012"
                BorderBrush="#252B2D"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="24"
                           Height="24"
                           Source="/Assets/workspace-recall-icon.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="Space Recorder" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Click="MinimizeButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Maximize"
                            AutomationProperties.Name="Maximize"
                            Click="MaximizeButton_Click">
                        <TextBlock x:Name="MaximizeGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Click="CloseButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#252B2D"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Text="Default Layout" />
                    <Ellipse x:Name="CaptureStatusDot"
                             Width="8"
                             Height="8"
                             Margin="18,1,8,0"
                             Fill="{StaticResource SuccessBrush}" />
                    <TextBlock x:Name="CaptureStatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               Text="No capture yet" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                             VerticalAlignment="Center"
                             Orientation="Horizontal">
                    <CheckBox x:Name="SavePreviewsCheckBox"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              AutomationProperties.HelpText="Captures and stores screenshots of every included application window locally."
                              Foreground="{StaticResource MutedTextBrush}"
                              ToolTip="Off by default. When enabled, screenshots of application windows are stored locally.">
                        <TextBlock Text="Save window previews" />
                    </CheckBox>
                    <Button x:Name="CaptureButton"
                            MinWidth="192"
                            Height="44"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Capture current layout"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="CaptureButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,9,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE72C;" />
                            <TextBlock x:Name="CaptureButtonText"
                                       Text="Capture current layout" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton"
                            MinWidth="180"
                            Height="44"
                            AutomationProperties.Name="Restore layout"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="RestoreButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,9,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE768;" />
                            <TextBlock Text="Restore layout" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.08*" />
                <ColumnDefinition Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#0B0F11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="3*" MinHeight="180" />
                    <RowDefinition Height="2*" MinHeight="190" />
                </Grid.RowDefinitions>
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Saved screen arrangement" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse Width="10" Height="10"
                                 Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Margin="8,0,22,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="File identified" />
                        <Ellipse Width="10" Height="10"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock Margin="8,0,22,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Program only" />
                        <Ellipse Width="10" Height="10"
                                 Fill="{StaticResource WarningBrush}" />
                        <TextBlock Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Needs review" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="MonitorCanvasHost"
                      Grid.Row="1"
                      Margin="22,4,22,22"
                      ClipToBounds="True"
                      SizeChanged="MonitorCanvasHost_SizeChanged">
                    <Canvas x:Name="MonitorCanvas" />
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Image Width="84"
                               Height="84"
                               HorizontalAlignment="Center"
                               Opacity="0.72"
                               Source="/Assets/workspace-recall-icon.png" />
                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Capture your current workspace" />
                        <TextBlock Width="430"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Open the files you want, arrange their windows, then capture the exact paths and screen positions."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="#0D1214"
                        BorderBrush="#303638"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Captured windows" />
                            <TextBlock x:Name="CapturedInventorySummary"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="32,0,32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="PROGRAM" />
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="CAPTURED ITEM" />
                            <TextBlock Grid.Column="3"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="IDENTIFICATION" />
                            <TextBlock Grid.Column="4"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="PLACEMENT" />
                        </Grid>
                        <ScrollViewer x:Name="CapturedWindowInventory"
                                      Grid.Row="2"
                                      Margin="22,0,16,12"
                                      AutomationProperties.AutomationId="CapturedWindowInventory"
                                      PanningMode="VerticalOnly"
                                      VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="CapturedWindowList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Margin="{Binding HeaderMargin}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Header}" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6"
                                                                Background="#111618"
                                                                CornerRadius="7">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#2D3538" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{StaticResource AccentBrush}" />
                                                                            <Setter Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="112" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Tag="{Binding Window}"
                                                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                        AutomationProperties.Name="{Binding AutomationName}"
                                                                        AutomationProperties.HelpText="{Binding HelpText}"
                                                                        BorderThickness="0"
                                                                        Click="InventoryRow_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button"
                                                                               BasedOn="{StaticResource InventoryRowButtonStyle}">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="#17272D" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="40" />
                                                                            <ColumnDefinition Width="1.1*" />
                                                                            <ColumnDefinition Width="1.35*" />
                                                                            <ColumnDefinition Width="115" />
                                                                            <ColumnDefinition Width="120" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Image Width="24"
                                                                               Height="24"
                                                                               HorizontalAlignment="Left"
                                                                               VerticalAlignment="Center"
                                                                               Source="{Binding Icon}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Margin="4,0,12,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding ApplicationName}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding ApplicationName}" />
                                                                        <TextBlock Grid.Column="2"
                                                                                   Margin="4,0,12,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding CapturedItem}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding CapturedItemToolTip}" />
                                                                        <Border Grid.Column="3"
                                                                                Margin="4,0,12,0"
                                                                                Padding="9,4"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Background="{Binding StatusBackground}"
                                                                                BorderBrush="{Binding StatusBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10">
                                                                            <TextBlock Foreground="{Binding StatusBrush}"
                                                                                       FontSize="11"
                                                                                       Text="{Binding StatusLabel}" />
                                                                        </Border>
                                                                        <TextBlock Grid.Column="4"
                                                                                   Margin="4,0,12,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding Placement}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Placement}" />
                                                                    </Grid>
                                                                </Button>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="4,0,10,0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding ActionVisibility}">
                                                                    <Button Width="100"
                                                                            Height="27"
                                                                            Margin="0,0,0,4"
                                                                            Padding="7,3"
                                                                            Tag="{Binding Window}"
                                                                            AutomationProperties.AutomationId="{Binding ChooseFileAutomationId}"
                                                                            AutomationProperties.Name="{Binding ChooseFileAutomationName}"
                                                                            Style="{StaticResource CommandButtonStyle}"
                                                                            Content="Choose file"
                                                                            Click="InventoryChooseFileButton_Click" />
                                                                    <Button Width="100"
                                                                            Height="27"
                                                                            Padding="7,3"
                                                                            Tag="{Binding Window}"
                                                                            AutomationProperties.AutomationId="{Binding ProgramOnlyAutomationId}"
                                                                            AutomationProperties.Name="{Binding ProgramOnlyAutomationName}"
                                                                            Style="{StaticResource CommandButtonStyle}"
                                                                            Content="Program only"
                                                                            IsEnabled="{Binding Window.HasUsableExecutable}"
                                                                            Click="InventoryProgramOnlyButton_Click" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#303638"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="11*" />
                        <RowDefinition Height="9*" MinHeight="230" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="28,24,28,30">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Selected window" />

                            <Grid x:Name="SelectedWindowPanel" Margin="0,24,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46"
                                            Height="46"
                                            Padding="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="#202628"
                                            BorderBrush="#343B3D"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Image x:Name="SelectedAppIcon" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedFileName"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <Ellipse x:Name="SelectedStatusDot"
                                                     Width="8"
                                                     Height="8"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{StaticResource SuccessBrush}" />
                                            <TextBlock x:Name="SelectedStatusInline"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,34,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="Application" />
                                    <TextBlock x:Name="SelectedApplication"
                                               Grid.Column="1"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="File path" />
                                    <TextBlock x:Name="SelectedFilePath"
                                               Grid.Column="1"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="Detection status" />
                                    <Border x:Name="SelectedDetectionBadge"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            Padding="10,4"
                                            Background="#173923"
                                            BorderBrush="#2F8050"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock x:Name="SelectedDetectionText"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="4" Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="Placement" />
                                    <TextBlock x:Name="SelectedPlacement"
                                               Grid.Column="1" />
                                </Grid>
                                <Grid Grid.Row="5" Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="State" />
                                    <TextBlock x:Name="SelectedState"
                                               Grid.Column="1" />
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="NoSelectionText"
                                       Margin="0,30,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Capture a workspace, then select a window to inspect its file path and position."
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <Button x:Name="OpenLocationButton"
                                    Width="180"
                                    Height="42"
                                    Margin="0,28,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Open file location"
                                    Style="{StaticResource CommandButtonStyle}"
                                    Click="OpenLocationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,9,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="&#xE838;" />
                                    <TextBlock Text="Open file location" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Padding="28,20,28,22"
                            BorderBrush="#303638"
                            BorderThickness="0,1,0,0">
                        <ScrollViewer PanningMode="VerticalOnly"
                                      VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <Grid>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Restore readiness" />
                                <TextBlock x:Name="ReadyCountText"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                                <Border x:Name="AttentionPanel"
                                    Margin="0,20,0,0"
                                    Padding="16"
                                    Background="#201C0D"
                                    BorderBrush="#9B7500"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource WarningBrush}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="18"
                                               Text="&#xE814;" />
                                    <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                        <TextBlock x:Name="AttentionFileName"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="This app did not expose its file path."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            MinWidth="100"
                                            Height="36"
                                            Style="{StaticResource CommandButtonStyle}"
                                            Content="Choose file…"
                                            Click="ChooseFileButton_Click" />
                                    <Button x:Name="MarkProgramOnlyButton"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            MinWidth="138"
                                            Height="36"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource CommandButtonStyle}"
                                            Content="Mark program only"
                                            Click="MarkProgramOnlyButton_Click" />
                                    <Button Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource AccentBrush}"
                                            Cursor="Hand"
                                            Content="Exclude from layout"
                                            Click="ExcludeButton_Click" />
                                </Grid>
                                </Border>
                                <TextBlock x:Name="AllReadyText"
                                       Margin="0,18,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Every included window is ready to restore."
                                       Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#303638"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="WindowCountText"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Margin="10,0"
                               Foreground="#5F686C"
                               Text="·" />
                    <TextBlock x:Name="DisplayCountText"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Margin="10,0"
                               Foreground="#5F686C"
                               Text="·" />
                    <TextBlock x:Name="AttentionCountText"
                               Foreground="{StaticResource WarningBrush}" />
                    <TextBlock x:Name="ActivityText"
                               Margin="22,0,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Orientation="Horizontal">
                    <Button x:Name="RevitIntegrationButton"
                            Height="32"
                            Margin="0,0,18,0"
                            Padding="12,5"
                            AutomationProperties.Name="Enable Revit integration"
                            Style="{StaticResource CommandButtonStyle}"
                            Content="Enable Revit integration"
                            Click="RevitIntegrationButton_Click" />
                    <TextBlock Margin="0,0,9,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17"
                               Text="&#xE72E;" />
